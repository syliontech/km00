/**
 * 工作流状态管理模块
 * 负责处理工作流状态的切换和UI更新
 */

// 创建全局命名空间对象，如果不存在
// 这确保我们的函数可以在全局范围内被访问
window.ProductSystem = window.ProductSystem || {};
window.ProductSystem.WorkflowManager = window.ProductSystem.WorkflowManager || {};

document.addEventListener('DOMContentLoaded', function() {
    console.log('初始化工作流状态管理模块');
    
    // 初始化工作流状态管理
    initWorkflowStateManagement();
});

// 全局变量
let workflowState = 'idle'; // 工作流状态：idle(待机), new(新建), edit(编辑), modify(修改)
let workflowLoopStarted = false; // 工作流闭环是否已启动
let currentProductCode = ''; // 当前产品编码
let currentRecordNumber = ''; // 当前记录编号

// 将关键函数添加到全局命名空间
// 这样其他脚本可以访问这些函数
window.initWorkflowStateManagement = initWorkflowStateManagement;
window.changeWorkflowState = changeWorkflowState;
window.updateUIByWorkflowState = updateUIByWorkflowState;
window.startWorkflowLoop = startWorkflowLoop;
window.endWorkflowLoop = endWorkflowLoop;
window.cancelOperation = cancelOperation;

/**
 * 初始化工作流状态管理
 */
function initWorkflowStateManagement() {
    try {
        console.log('开始初始化工作流状态管理');
        
        // 获取工作流相关按钮
        const newBtn = document.getElementById('new-record-btn'); // 注意在HTML中的ID是'new-record-btn'
        const editBtn = document.getElementById('edit-btn');
        const modifyBtn = document.getElementById('modify-btn');
        const saveRecordBtn = document.getElementById('save-record-btn');
        const cancelBtn = document.getElementById('cancel-btn');
        const startNewBtn = document.getElementById('start-new-btn'); // 待机状态遮罩中的新建按钮
        
        console.log('按钮状态:', {
            newBtn: !!newBtn,
            editBtn: !!editBtn,
            modifyBtn: !!modifyBtn,
            saveRecordBtn: !!saveRecordBtn,
            cancelBtn: !!cancelBtn,
            startNewBtn: !!startNewBtn
        });
        
        // 新建按钮点击事件
        if (newBtn) {
            console.log('添加新建按钮点击事件');
            newBtn.addEventListener('click', function() {
                console.log('新建按钮被点击');
                // 切换到新建状态
                changeWorkflowState('new');
            });
        }
        
        // 待机状态遮罩中的新建按钮点击事件
        if (startNewBtn) {
            console.log('添加待机状态遮罩中的新建按钮点击事件');
            startNewBtn.addEventListener('click', function() {
                console.log('遮罩中的新建按钮被点击');
                // 切换到新建状态
                changeWorkflowState('new');
            });
        }
        
        // 编辑按钮点击事件
        if (editBtn) {
            editBtn.addEventListener('click', function() {
                // 切换到编辑状态
                changeWorkflowState('edit');
            });
        }
        
        // 修改按钮点击事件
        if (modifyBtn) {
            modifyBtn.addEventListener('click', function() {
                // 切换到修改状态
                changeWorkflowState('modify');
            });
        }
        
        // 保存记录按钮点击事件
        if (saveRecordBtn) {
            saveRecordBtn.addEventListener('click', function() {
                // 保存记录并返回待机状态
                saveRecord();
            });
        }
        
        // 取消按钮点击事件
        if (cancelBtn) {
            cancelBtn.addEventListener('click', function() {
                // 取消当前操作并返回待机状态
                cancelOperation();
            });
        }
        
        // 初始化UI状态
        updateUIByWorkflowState();
        
        console.log('工作流状态管理初始化完成');
    } catch (e) {
        console.error('初始化工作流状态管理时发生错误:', e);
    }
}

/**
 * 初始化规格编辑按钮事件
 */
function initSpecEditButtons() {
    // 获取所有规格编辑按钮
    const editSpecBtns = document.querySelectorAll('.edit-spec-btn');
    
    // 为每个编辑按钮添加点击事件
    editSpecBtns.forEach(btn => {
        btn.addEventListener('click', function() {
            const specId = this.getAttribute('data-spec-id');
            console.log(`编辑规格 ${specId}`);
            // 这里添加编辑规格的逻辑
        });
    });
}

/**
 * 切换工作流状态
 * @param {string} newState - 新状态：'idle', 'new', 'edit', 'modify'
 */
function changeWorkflowState(newState) {
    try {
        console.log(`尝试将工作流状态从 ${workflowState} 切换到 ${newState}`);
        
        // 验证状态参数
        if (!newState) {
            console.error('工作流状态不能为空');
            return;
        }
        
        // 检查状态是否有效
        const validStates = ['idle', 'new', 'edit', 'modify'];
        if (!validStates.includes(newState)) {
            console.error(`无效的工作流状态: ${newState}`);
            return;
        }
        
        // 记录旧状态
        const oldState = workflowState;
        
        // 更新工作流状态
        workflowState = newState;
        console.log(`工作流状态已从 ${oldState} 切换到 ${newState}`);
        
        // 更新右区面板的状态属性
        const rightPanel = document.getElementById('rightPanel');
        if (rightPanel) {
            console.log(`更新右区面板的data-state属性为 ${newState}`);
            rightPanel.setAttribute('data-state', newState);
        } else {
            console.warn('未找到右区面板元素');
        }
        
        // 更新工作流状态显示
        const statusIndicator = document.getElementById('status-indicator');
        if (statusIndicator) {
            let statusText = '';
            let statusClass = '';
            
            switch (newState) {
                case 'idle':
                    statusText = '待机状态';
                    statusClass = 'bg-gray-200 text-gray-700';
                    break;
                case 'new':
                    statusText = '新建状态';
                    statusClass = 'bg-blue-200 text-blue-700';
                    break;
                case 'edit':
                    statusText = '编辑状态';
                    statusClass = 'bg-yellow-200 text-yellow-700';
                    break;
                case 'modify':
                    statusText = '修改状态';
                    statusClass = 'bg-green-200 text-green-700';
                    break;
            }
            
            // 更新状态指示器的文本和类
            statusIndicator.innerHTML = `<i class="fas fa-clock mr-1"></i>${statusText}`;
            
            // 移除所有颜色类
            statusIndicator.className = statusIndicator.className.replace(/bg-\w+-\d+ text-\w+-\d+/g, '');
            // 添加新的颜色类
            statusIndicator.className += ` ${statusClass}`;
            
            console.log(`更新状态指示器为: ${statusText}`);
        } else {
            console.warn('未找到状态指示器元素');
        }
        
        // 根据新状态更新UI
        console.log('调用updateUIByWorkflowState更新UI');
        updateUIByWorkflowState();
        
        // 如果是从待机状态切换到新建或编辑状态，启动工作流闭环
        if (oldState === 'idle' && (newState === 'new' || newState === 'edit')) {
            console.log('启动工作流闭环');
            startWorkflowLoop();
        }
        
        // 触发工作流状态变更事件
        const event = new CustomEvent('workflow-state-changed', {
            detail: { oldState, newState }
        });
        document.dispatchEvent(event);
        console.log('已触发workflow-state-changed事件');
        
    } catch (e) {
        console.error('切换工作流状态时发生错误:', e);
    }
}

/**
 * 根据工作流状态更新UI
 */
function updateUIByWorkflowState() {
    try {
        console.log(`更新UI为工作流状态: ${workflowState}`);
        
        // 获取相关按钮和区域
        const newBtn = document.getElementById('new-record-btn'); // 注意在HTML中的ID是'new-record-btn'
        const startNewBtn = document.getElementById('start-new-btn');
        const editBtn = document.getElementById('edit-btn');
        const modifyBtn = document.getElementById('modify-btn');
        const saveRecordBtn = document.getElementById('save-record-btn');
        const cancelBtn = document.getElementById('cancel-btn');
        
        // 记录找到的按钮
        const foundButtons = [];
        if (newBtn) foundButtons.push('new-record-btn');
        if (startNewBtn) foundButtons.push('start-new-btn');
        if (editBtn) foundButtons.push('edit-btn');
        if (modifyBtn) foundButtons.push('modify-btn');
        if (saveRecordBtn) foundButtons.push('save-record-btn');
        if (cancelBtn) foundButtons.push('cancel-btn');
        console.log(`找到的按钮: ${foundButtons.join(', ')}`);
        
        // 更新待机状态遮罩的显示状态
        const idleOverlay = document.getElementById('idle-overlay');
        if (idleOverlay) {
            if (workflowState === 'idle') {
                console.log('显示待机状态遮罩');
                idleOverlay.style.display = 'flex';
            } else {
                console.log('隐藏待机状态遮罩');
                idleOverlay.style.display = 'none';
            }
        } else {
            console.warn('未找到待机状态遮罩元素');
        }
        
        // 根据工作流状态更新按钮状态
        switch (workflowState) {
            case 'idle':
                // 待机状态：只有新建按钮可用
                if (newBtn) {
                    newBtn.disabled = false;
                    console.log('启用新建按钮');
                }
                if (editBtn) {
                    editBtn.disabled = true;
                    console.log('禁用编辑按钮');
                }
                if (modifyBtn) {
                    modifyBtn.disabled = true;
                    console.log('禁用修改按钮');
                }
                if (saveRecordBtn) {
                    saveRecordBtn.disabled = true;
                    console.log('禁用保存记录按钮');
                }
                if (cancelBtn) {
                    cancelBtn.disabled = true;
                    console.log('禁用取消按钮');
                }
                break;
                
            case 'new':
            case 'edit':
            case 'modify':
                // 非待机状态：新建按钮不可用，保存和取消按钮可用
                if (newBtn) {
                    newBtn.disabled = true;
                    console.log('禁用新建按钮');
                }
                if (editBtn) {
                    editBtn.disabled = true;
                    console.log('禁用编辑按钮');
                }
                if (modifyBtn) {
                    modifyBtn.disabled = true;
                    console.log('禁用修改按钮');
                }
                if (saveRecordBtn) {
                    saveRecordBtn.disabled = false;
                    console.log('启用保存记录按钮');
                }
                if (cancelBtn) {
                    cancelBtn.disabled = false;
                    console.log('启用取消按钮');
                }
                break;
        }
        
        // 更新右区面板的状态类
        const rightPanel = document.getElementById('rightPanel');
        if (rightPanel) {
            // 移除所有状态类
            rightPanel.classList.remove('state-idle', 'state-new', 'state-edit', 'state-modify');
            // 添加当前状态类
            rightPanel.classList.add(`state-${workflowState}`);
            console.log(`更新右区面板的状态类为 state-${workflowState}`);
        }
    } catch (e) {
        console.error('更新UI时发生错误:', e);
    }
}

/**
 * 启动工作流闭环
 */
function startWorkflowLoop() {
    try {
        console.log('尝试启动工作流闭环');
        
        // 检查工作流状态
        if (workflowState === 'idle') {
            console.warn('当前为待机状态，无法启动工作流闭环');
            return;
        }
        
        // 检查是否已启动
        if (workflowLoopStarted) {
            console.warn('工作流闭环已经启动，不需要重复启动');
            return;
        }
        
        // 设置工作流闭环已启动
        workflowLoopStarted = true;
        
        // 生成产品编码
        currentProductCode = 'P-' + Math.floor(Math.random() * 10000).toString().padStart(4, '0');
        console.log(`工作流闭环已启动，产品编码: ${currentProductCode}`);
        
        // 更新产品信息区域
        const productCodeElement = document.getElementById('product-code');
        if (productCodeElement) {
            productCodeElement.textContent = currentProductCode;
            console.log(`更新产品编码显示为: ${currentProductCode}`);
        }
        
        // 触发工作流闭环启动事件
        const event = new CustomEvent('workflow-loop-started', {
            detail: { productCode: currentProductCode }
        });
        document.dispatchEvent(event);
        console.log('已触发workflow-loop-started事件');
    } catch (e) {
        console.error('启动工作流闭环时发生错误:', e);
    }
}

/**
 * 结束工作流闭环
 */
function endWorkflowLoop() {
    try {
        console.log('结束工作流闭环');
        
        // 检查工作流闭环是否已启动
        if (!workflowLoopStarted) {
            console.warn('工作流闭环尚未启动，无需结束');
            return;
        }
        
        // 设置工作流闭环已结束
        workflowLoopStarted = false;
        
        // 重置当前产品编码和记录编号
        currentProductCode = '';
        currentRecordNumber = '';
        
        // 切换到待机状态
        changeWorkflowState('idle');
        
        // 触发工作流闭环结束事件
        const event = new CustomEvent('workflow-loop-ended');
        document.dispatchEvent(event);
        console.log('已触发workflow-loop-ended事件');
    } catch (e) {
        console.error('结束工作流闭环时发生错误:', e);
    }
}

/**
 * 保存记录
 */
function saveRecord() {
    try {
        console.log('保存记录');
        
        // 检查工作流闭环是否已启动
        if (!workflowLoopStarted) {
            console.warn('工作流闭环尚未启动，无法保存记录');
            return;
        }
        
        // 收集表单数据
        const formData = collectFormData();
        
        // 生成记录编号
        currentRecordNumber = 'R-' + Math.floor(Math.random() * 10000).toString().padStart(4, '0');
        console.log(`生成记录编号: ${currentRecordNumber}`);
        
        // 模拟保存记录到数据库
        console.log('保存记录到数据库:', {
            recordNumber: currentRecordNumber,
            productCode: currentProductCode,
            formData: formData
        });
        
        // 添加记录到左区记录列表
        addRecordToList(currentRecordNumber, currentProductCode, formData);
        
        // 结束工作流闭环
        endWorkflowLoop();
        
        // 显示保存成功提示
        alert(`记录保存成功，记录编号: ${currentRecordNumber}`);
    } catch (e) {
        console.error('保存记录时发生错误:', e);
        alert('保存记录失败，请查看控制台获取详细错误信息');
    }
}

/**
 * 收集表单数据
 * @returns {Object} 表单数据对象
 */
function collectFormData() {
    // 这里实现收集表单数据的逻辑
    // 示例实现，实际应根据页面表单结构收集数据
    return {
        productName: document.getElementById('product-name')?.value || '',
        productType: document.getElementById('product-type')?.value || '',
        // 其他表单字段...
    };
}

/**
 * 添加记录到左区记录列表
 * @param {string} recordNumber - 记录编号
 * @param {string} productCode - 产品编码
 * @param {Object} formData - 表单数据
 */
function addRecordToList(recordNumber, productCode, formData) {
    // 获取左区记录列表元素
    const recordList = document.getElementById('record-list');
    if (!recordList) {
        console.warn('未找到记录列表元素');
        return;
    }
    
    // 创建记录项元素
    const recordItem = document.createElement('div');
    recordItem.className = 'bg-white p-2 mb-2 rounded shadow cursor-pointer hover:bg-gray-100';
    recordItem.setAttribute('data-record-number', recordNumber);
    
    // 设置记录项内容
    recordItem.innerHTML = `
        <div class="font-medium">${formData.productName || '未命名产品'}</div>
        <div class="text-sm text-gray-600">编号: ${recordNumber}</div>
        <div class="text-sm text-gray-600">产品码: ${productCode}</div>
    `;
    
    // 添加点击事件，用于加载记录
    recordItem.addEventListener('click', function() {
        loadRecord(recordNumber);
    });
    
    // 添加到记录列表
    recordList.appendChild(recordItem);
}

/**
 * 加载记录
 * @param {string} recordNumber - 记录编号
 */
function loadRecord(recordNumber) {
    console.log(`加载记录: ${recordNumber}`);
    // 这里实现加载记录的逻辑
    // 示例实现，实际应从数据库加载记录数据
    
    // 切换到编辑状态
    changeWorkflowState('edit');
}

/**
 * 取消操作
 */
function cancelOperation() {
    // 提示用户确认取消
    if (confirm('确定要取消当前操作吗？所有未保存的数据将丢失。')) {
        // 清空右区数据
        clearRightPanel();
        
        // 切换到待机状态
        changeWorkflowState('idle');
    }
}

/**
 * 清空右区数据
 */
function clearRightPanel() {
    console.log('清空右区数据');
    
    // 清空所有输入框
    const inputs = document.querySelectorAll('#rightPanel input, #rightPanel textarea, #rightPanel select');
    inputs.forEach(input => {
        input.value = '';
    });
    
    // 清空规格列表
    const specsList = document.getElementById('specs-list');
    if (specsList) {
        specsList.innerHTML = '';
    }
    
    // 清空组套列表
    const kitList = document.getElementById('kit-list');
    if (kitList) {
        kitList.innerHTML = '';
    }
    
    // 清空供应商列表
    const vendorsList = document.getElementById('vendors-list');
    if (vendorsList) {
        vendorsList.innerHTML = '';
    }
    
    // 清空客户列表
    const clientsList = document.getElementById('clients-list');
    if (clientsList) {
        clientsList.innerHTML = '';
    }
    
    // 清空上传文件列表
    const uploadedFilesList = document.getElementById('uploaded-files-list');
    if (uploadedFilesList) {
        uploadedFilesList.innerHTML = '';
    }
    
    // 清空文件展示列表
    const filesDisplayList = document.getElementById('files-display-list');
    if (filesDisplayList) {
        filesDisplayList.innerHTML = '';
    }
}

/**
 * 更新文件展示列表
 */
function updateFilesDisplayList() {
    const filesDisplayList = document.getElementById('files-display-list');
    const uploadedFilesList = document.getElementById('uploaded-files-list');
    
    if (!filesDisplayList || !uploadedFilesList) return;
    
    // 清空展示列表
    filesDisplayList.innerHTML = '';
    
    // 从上传文件列表复制文件到展示列表
    uploadedFilesList.querySelectorAll('.cursor-pointer').forEach(fileItem => {
        const fileIcon = fileItem.querySelector('i').cloneNode(true);
        const fileName = fileItem.querySelector('div').textContent.trim();
        const fileId = fileItem.getAttribute('data-file-id');
        
        const fileLink = document.createElement('a');
        fileLink.href = '#';
        fileLink.className = 'block hover:bg-gray-100 p-1 rounded';
        fileLink.setAttribute('data-file-id', fileId);
        
        fileLink.innerHTML = `
            <div class="flex items-center">
                ${fileIcon.outerHTML}
                <span class="ml-1 text-sm">${fileName}</span>
            </div>
        `;
        
        fileLink.addEventListener('click', function(e) {
            e.preventDefault();
            // 预览文件
            previewFile(fileId);
        });
        
        filesDisplayList.appendChild(fileLink);
    });
}

/**
 * 预览文件
 * @param {string} fileId - 文件ID
 */
function previewFile(fileId) {
    console.log(`预览文件: ${fileId}`);
    // 这里实现文件预览逻辑
}
